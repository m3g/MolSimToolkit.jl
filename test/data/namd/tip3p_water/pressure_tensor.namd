structure          water.psf
coordinates        water.pdb
bincoordinates     equil.coor
binvelocities      equil.vel
extendedSystem     equil.xsc
paraTypeCharmm     on
parameters         tip3p.prm
exclude            scaled1-4
1-4scaling         1.0
cutoff             12.0
switching          on
switchdist         10.0
pairlistdist       14.0
PME                yes
PMEGridSpacing     1.0
rigidBonds         all
rigidTolerance     1.0e-8
timestep           2.0
nonbondedFreq      1
fullElectFrequency 1
stepspercycle      10
wrapAll            on
outputName         short
outputEnergies     100
outputPressure     1
restartfreq        100000
run                2000
